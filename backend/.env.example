# Variáveis de ambiente — Backend (Vestibular App TCC)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA versione o arquivo .env com credenciais reais.

# --- Servidor ---
PORT=3000

# --- Banco de Dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=vestibular_db

# --- Autenticação JWT ---
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria
JWT_EXPIRES_IN=7d
