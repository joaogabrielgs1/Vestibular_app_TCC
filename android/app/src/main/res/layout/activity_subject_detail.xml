<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/background">

    <!-- Cabeçalho -->
    <TextView
        android:id="@+id/tvSubjectDetailTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Matemática"
        android:textColor="@color/primary_dark"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubjectDetailSub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Histórico detalhado de questões desta disciplina"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubjectDetailTitle" />

    <!-- Botões de Alternância (Abas): Acertos / Erros -->
    <LinearLayout
        android:id="@+id/layoutToggleTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubjectDetailSub">

        <Button
            android:id="@+id/btnTabCorrect"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/success"
            android:text="✓ Questões Acertadas"
            android:textColor="@color/surface"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabWrong"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="✗ Questões Erradas"
            android:textColor="@color/error"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lista de Questões -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshSubjectQuestions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutToggleTabs">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSubjectQuestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Mensagem de Vazio -->
    <TextView
        android:id="@+id/tvEmptySubjectQuestions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nenhuma questão encontrada para este filtro."
        android:visibility="gone"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutToggleTabs" />

</androidx.constraintlayout.widget.ConstraintLayout>
