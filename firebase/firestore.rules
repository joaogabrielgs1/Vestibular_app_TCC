rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Coleções públicas para leitura no aplicativo (matérias, vestibulares, questões)
    // Escrita proibida para clientes diretos (gerenciadas por scripts/admin via Cloud Functions)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false;
    }

    match /vestibulares/{vestibularId} {
      allow read: if true;
      allow write: if false;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // Dados de usuários: apenas o próprio usuário autenticado pode ler/escrever
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Respostas individuais: apenas o autor pode acessar
    match /answers/{answerId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Simulados e histórico: apenas o dono do simulado pode gerenciar
    match /simulations/{simulationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Regra padrão: bloqueia qualquer outra coleção não declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
